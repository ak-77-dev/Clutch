# League of Legends — https://developer.riotgames.com (dev keys expire every 24h)
RIOT_API_KEY=
LOL_PLATFORM=na1            # na1, euw1, eun1, kr, br1, jp1, oc1, ...

# Valorant — free key from https://docs.henrikdev.xyz (Discord verification)
HENRIK_API_KEY=

# Rocket League — token from https://ballchasing.com/upload
BALLCHASING_API_KEY=

# Teamfight Tactics uses RIOT_API_KEY too.

# Counter-Strike 2 (FACEIT matches) — server-side key from https://developers.faceit.com
FACEIT_API_KEY=

# PUBG — https://developer.pubg.com (PUBG_SHARD: steam, kakao, psn, xbox, console)
PUBG_API_KEY=
# PUBG_SHARD=steam

# Brawl Stars / Clash Royale — https://developer.brawlstars.com, https://developer.clashroyale.com
# Supercell keys only work from the IP addresses you list when you create them.
BRAWLSTARS_API_KEY=
CLASHROYALE_API_KEY=

# osu! — create an OAuth app at https://osu.ppy.sh/home/account/edit (any callback URL)
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Call of Duty (experimental) — your ACT_SSO_COOKIE from a signed-in callofduty.com session
# COD_SSO_TOKEN=

# CLUTCH_DB=clutch.db

# Dota 2, Deadlock, Chess.com and Lichess work without keys. Optional: lifts OpenDota's 60 req/min keyless cap.
# OPENDOTA_API_KEY=
