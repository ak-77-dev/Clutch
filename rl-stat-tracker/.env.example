# ballchasing.com API token — shown at https://ballchasing.com/upload once you log in.
BALLCHASING_API_KEY=

# Who to track. Optional: when both are empty, `rlstats sync` tracks the Steam
# account that owns the API key. Platform id is preferred over name because
# names change and can collide (steam:7656119..., epic:<id>, psynet:<id>, xbox:<id>).
RL_PLAYER_ID=
RL_PLAYER_NAME=

# Optional paths
# RLSTATS_DB=rlstats.db
# RLSTATS_OUTPUT=dashboard.html
